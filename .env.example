# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── Database (Neon Postgres, shared with the website) ─────────────────────
# One connection string, taken from the Vercel project:
#   Vercel → bss-logisq-website → Storage → bss → .env.local → Show secret
# Use the POOLED host (the one with "-pooler" in it, which DATABASE_URL is).
#
# This is the SAME database the website writes inquiries into. Nothing syncs
# between the two applications — they read and write the same rows.
#
# QUOTE it. '#' starts a comment in a .env file, and a connection string
# containing one is silently truncated, which fails as "password
# authentication failed" with a value that looks correct in the file.
DATABASE_URL=""

# ── The website's key for posting inquiries here ──────────────────────────
# Only needed if the website still posts to /api/inquiries. Now that both
# applications share one database, the website writes to it directly and this
# endpoint is a fallback rather than the normal path.
# Generate it, do not invent one:  openssl rand -hex 32
INGEST_TOKEN=

# ── Screen without a database ─────────────────────────────────────────────
# DEMO_DATA=1 fills the desk with made-up inquiries and opens no connection.
DEMO_DATA=

# ── Mail: sending replies, and collecting the answers ─────────────────────
# All of it goes through Microsoft Graph against ONE shared mailbox. No SMTP:
# Microsoft has disabled basic auth for SMTP and IMAP, so an SMTP route would
# need OAuth anyway — this way one app registration does both.
#
# The app registration needs, as APPLICATION permissions with admin consent:
#   Mail.Send        — to send
#   Mail.ReadWrite   — to read replies and mark them read
#
# Both are tenant-wide by default. Limit the app to this one mailbox with an
# Exchange Online application access policy, or the desk can read every
# mailbox in the company:
#   New-ApplicationAccessPolicy -AppId <client-id> `
#     -PolicyScopeGroupId contact@bss-logisq.com -AccessRight RestrictAccessTo
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=""

# The shared mailbox the desk sends as and reads from.
MAIL_MAILBOX=contact@bss-logisq.com

# The plain address replies come back to — normally the same as MAIL_MAILBOX.
# Nothing is added to it: a reply is matched to its inquiry by the mail's own
# threading headers (In-Reply-To / References, against the stored Message-ID),
# and as a fallback by the [BSS-MX-<id>] tag the desk adds to each subject.
MAIL_REPLY_ADDRESS=contact@bss-logisq.com

# Guards /api/mail/poll. Leave empty only while the port is bound to
# 127.0.0.1. The cron line that collects replies:
#   * * * * * curl -fsS -H "x-poll-token: $POLL_TOKEN" \
#       http://127.0.0.1:3100/api/mail/poll
POLL_TOKEN=
